{
  "name": "facetime-support-agent",
  "version": "1.0.0",
  "scripts": {
    "screens:demo": "node --import tsx src/screens/demo/server.ts",
    "screens:test": "node --import tsx --test src/screens/screens.test.ts",
    "agent": "tsx --env-file=.env.local src/agent/agent.ts dev",
    "agent:mock": "MOCK_INTELLIGENCE=1 tsx --env-file=.env.local src/agent/agent.ts dev",
    "agent:start": "tsx --env-file=.env.local src/agent/agent.ts start",
    "server": "tsx watch --env-file=.env.local src/telephony/server.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:8787",
    "try:intel": "tsx --env-file-if-exists=.env.local src/intelligence/try.ts",
    "typecheck": "tsc -p .",
    "smoke": "tsx --env-file-if-exists=.env.local src/smoke.ts",
    "agent:cli": "INTELLIGENCE_PROVIDER=codex-cli MOCK_INTELLIGENCE=0 tsx --env-file=.env.local src/agent/agent.ts dev",
    "imessage": "tsx --env-file=.env.local src/imessage/index.ts",
    "imessage:sim": "MOCK_INTELLIGENCE=1 tsx --env-file-if-exists=.env.local src/imessage/simulate.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@livekit/agents": "1.8.0",
    "@livekit/agents-plugin-openai": "1.8.0",
    "@livekit/rtc-node": "0.13.35",
    "@napi-rs/canvas": "1.0.13",
    "hono": "4.13.13",
    "livekit-server-sdk": "2.19.2",
    "openai": "7.43.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.2 || ^24.0.0"
  }
}
