# LiveKit Cloud project (cloud.livekit.io > Settings > Keys). Same values for agent + server.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Dispatch name. Must match `chert dev --agent <name>` if you use the CLI path.
AGENT_NAME=support-agent

# OpenAI: Realtime voice + vision diagnosis
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
VISION_MODEL=gpt-5
EXTRACT_MODEL=gpt-5-mini

# Keenable web search for manuals + LED codes ($200 credits at check-in). Leave blank to use the keyless /public endpoint.
KEENABLE_API_KEY=


# Optional: Chert iMessage (console.trychert.com > API keys). Blank = skip texting.
CHERT_MESSAGING_SECRET=

# Server
PORT=8787
# Where the agent posts live events (dashboard). Same machine = localhost.
SERVER_URL=http://localhost:8787
# Chert decision budget from created_at, ms (Chert default deadline is 5000)
CHERT_DECISION_BUDGET_MS=4000

# Brand the agent works for (shown on the card and in the prompt)
BRAND_NAME=Lumen Fiber
# Cost of one technician visit, for the "truck rolls avoided" KPI
TRUCK_ROLL_COST=150
